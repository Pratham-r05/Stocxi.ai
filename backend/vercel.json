{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "config/**",
          "backend/config/**",
          "../config/**",
          "../docs/output/**",
          "docs/output/**",
          "fetch_phase1_data.py",
          "../fetch_phase1_data.py",
          "build_knowledge_graph.py",
          "../build_knowledge_graph.py",
          "data/**",
          "../data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
