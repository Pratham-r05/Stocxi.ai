# Copy this to .env and fill in your values
# Never commit .env to git

# Upstash Redis — get from https://console.upstash.com
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@noble-kingfish-98306.upstash.io:6379

# Google Vertex AI — Gemini 2.5 Pro
# Service account JSON path (relative to project root)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID_
GOOGLE_APPLICATION_CREDENTIALS=../vertex_credentials.json

# CORS
# Local dev: ALLOWED_ORIGINS_RAW=*
# Production: set your frontend Vercel URL only
ALLOWED_ORIGINS_RAW=*

# Newsdata.io — primary news source (200 req/day free tier)
# Get key from: https://newsdata.io/api-key
NEWSDATA_API_KEY=YOUR_NEWSDATA_API_KEY_HERE

# Environment: development | production
ENVIRONMENT=development
