# Copy this to .env and fill in your values
# Never commit .env to git

# Upstash Redis — get from https://console.upstash.com
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@noble-kingfish-98306.upstash.io:6379

# OpenRouter — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# CORS
# Local dev: ALLOWED_ORIGINS_RAW=*
# Production: set your frontend Vercel URL only
ALLOWED_ORIGINS_RAW=*

# Environment: development | production
ENVIRONMENT=development

# Sentiment uses rdt-cli and twitter-cli (no credentials in .env)
# Install: pipx install rdt-cli && pipx install twitter-cli
