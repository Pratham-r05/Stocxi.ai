{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/api/index.py"
    }
  ],
  "functions": {
    "backend/api/index.py": {
      "includeFiles": "config/**",
      "excludeFiles": "{frontend/**,.venv/**,.venv312/**,.conda/**,stoxk/**,.claude/**,.git/**,reports/**,analysis-out/**,raw/**,docs/archive/**,docs/architecture/**,docs/progress/**,docs/superpowers/**,backend/tests/**,backend/test_*.py,backend/**/__pycache__/**,__pycache__/**,**/*.pyc,**/.DS_Store}"
    },
    "*.py": {
      "includeFiles": "config/**"
    }
  }
}
