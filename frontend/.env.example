# Frontend public API base (backend Vercel URL)
NEXT_PUBLIC_API_URL=https://your-backend-project.vercel.app

# NextAuth required settings
NEXTAUTH_URL=https://your-frontend-project.vercel.app
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Google OAuth (optional but needed for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared Redis for auth user persistence in production
# Reuse your Upstash rediss:// URL
REDIS_URL=rediss://:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
